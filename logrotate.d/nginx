# Как из 3,5 млн сделать 12 за год:
# месячная ротация access/error логов nginx → 12 архивов в год
# вместо одного файла на миллионы строк.
#
# Установка: скопировать в /etc/logrotate.d/nginx

/var/log/nginx/*.log {
	monthly
	rotate 12
	missingok
	notifempty
	compress
	delaycompress
	create 0640 www-data adm
	sharedscripts
	postrotate
		[ -f /run/nginx.pid ] && kill -USR1 "$(cat /run/nginx.pid)"
	endscript
}
